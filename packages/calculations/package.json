{
  "name": "@olivar/calculations",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pure calculation functions for OlivarCalc. No I/O, no browser APIs, no system clock (spec §4.1, §15).",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src tests"
  },
  "dependencies": {
    "big.js": "7.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@olivar/config": "*",
    "@types/big.js": "7.0.0",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "5.0.2",
    "eslint": "^10.11.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.0",
    "vitest": "5.0.2"
  }
}
