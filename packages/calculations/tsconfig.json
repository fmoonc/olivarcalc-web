{
  "extends": "@olivar/config/tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "noEmit": true,
    // "node" is for the fixture reader in tests; the library itself stays free
    // of Node APIs so it can run in React Native (spec §15).
    "types": ["vitest/globals", "node"]
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"]
}
