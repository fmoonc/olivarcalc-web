    "@tanstack/react-query": "^5.0.0"
  },
  "peerDependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@olivar/config": "*",
    "orval": "8.37.0",
    "typescript": "^5.9.3"
  }
}
