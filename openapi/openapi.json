{
    "openapi": "3.1.0",
    "info": {
        "title": "OlivarCalc API",
        "version": "0.0.1"
    },
    "servers": [
        {
            "url": "https://olivarcalc.es/api",
            "description": "Prod"
        }
    ],
    "paths": {
        "/v1/build-manifest": {
            "get": {
                "operationId": "v1.build-manifest",
                "tags": [
                    "BuildManifest"
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "generated_at": {
                                            "type": "string"
                                        },
                                        "campaign": {
                                            "type": [
                                                "string",
                                                "null"
                                            ]
                                        },
                                        "latest_price_week": {
                                            "type": [
                                                "string",
                                                "null"
                                            ]
                                        },
                                        "articles": {
                                            "type": "array",
                                            "items": {
                                                "type": "object",
                                                "properties": {
                                                    "slug": {
                                                        "type": "string"
                                                    },
                                                    "lastmod": {
                                                        "type": [
                                                            "string",
                                                            "null"
                                                        ],
                                                        "description": "A guide's lastmod is the later of publication and last edit."
                                                    },
                                                    "related_tool": {
                                                        "type": [
                                                            "string",
                                                            "null"
                                                        ]
                                                    }
                                                },
                                                "required": [
                                                    "slug",
                                                    "lastmod",
                                                    "related_tool"
                                                ]
                                            }
                                        },
                                        "categories": {
                                            "type": "array",
                                            "items": {
                                                "type": "object",
                                                "properties": {
                                                    "slug": {
                                                        "type": "string"
                                                    },
                                                    "name": {
                                                        "type": "string"
                                                    }
                                                },
                                                "required": [
                                                    "slug",
                                                    "name"
                                                ]
                                            }
                                        },
                                        "tool_pages": {
                                            "type": "array",
                                            "items": {
                                                "type": "object",
                                                "properties": {
                                                    "tool_key": {
                                                        "type": "string"
                                                    },
                                                    "lastmod": {
                                                        "type": [
                                                            "string",
                                                            "null"
                                                        ]
                                                    }
                                                },
                                                "required": [
                                                    "tool_key",
                                                    "lastmod"
                                                ]
                                            }
                                        }
                                    },
                                    "required": [
                                        "generated_at",
                                        "campaign",
                                        "latest_price_week",
                                        "articles",
                                        "categories",
                                        "tool_pages"
                                    ]
                                }
                            }
                        }
                    }
                }
            }
        },
        "/v1/categories": {
            "get": {
                "operationId": "v1.categories",
                "summary": "GET /api/v1/categories",
                "tags": [
                    "Content"
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/v1/articles": {
            "get": {
                "operationId": "v1.articles.index",
                "description": "Paginated in Laravel's standard shape (data / links / meta), spec §7.1.",
                "summary": "GET /api/v1/articles",
                "tags": [
                    "Content"
                ],
                "parameters": [
                    {
                        "name": "category",
                        "in": "query",
                        "schema": {
                            "type": "string",
                            "maxLength": 100
                        }
                    },
                    {
                        "name": "tool",
                        "in": "query",
                        "schema": {
                            "type": "string",
                            "enum": [
                                "settlement",
                                "yield_converter",
                                "cost_per_hectare",
                                "harvest_crew"
                            ]
                        }
                    },
                    {
                        "name": "page",
                        "in": "query",
                        "schema": {
                            "type": "integer",
                            "minimum": 1
                        }
                    },
                    {
                        "name": "per_page",
                        "in": "query",
                        "schema": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 50
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationException"
                    }
                }
            }
        },
        "/v1/articles/{slug}": {
            "get": {
                "operationId": "v1.articles.show",
                "summary": "GET /api/v1/articles/{slug}",
                "tags": [
                    "Content"
                ],
                "parameters": [
                    {
                        "name": "slug",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "message": {
                                            "type": "string"
                                        }
                                    },
                                    "required": [
                                        "message"
                                    ]
                                }
                            }
                        }
                    }
                }
            }
        },
        "/v1/tool-pages/{toolKey}": {
            "get": {
                "operationId": "v1.tool-pages.show",
                "summary": "GET /api/v1/tool-pages/{tool_key}",
                "tags": [
                    "Content"
                ],
                "parameters": [
                    {
                        "name": "toolKey",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "message": {
                                            "type": "string"
                                        }
                                    },
                                    "required": [
                                        "message"
                                    ]
                                }
                            }
                        }
                    }
                }
            }
        },
        "/v1/affiliate-products": {
            "get": {
                "operationId": "v1.affiliate-products",
                "summary": "GET /api/v1/affiliate-products",
                "tags": [
                    "Content"
                ],
                "parameters": [
                    {
                        "name": "category",
                        "in": "query",
                        "schema": {
                            "type": "string",
                            "maxLength": 100
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationException"
                    }
                }
            }
        },
        "/v1/index-quotes/latest": {
            "get": {
                "operationId": "v1.index-quotes.latest",
                "description": "Open to the public like the rest of the price data: the point of\nrepublishing an index is that growers can see it. Scramble documents this\nfrom the docblock and types.",
                "summary": "The most recent window POOLred published for all four of its indices",
                "tags": [
                    "IndexQuote"
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/OilIndexQuoteResource"
                                            }
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    }
                }
            }
        },
        "/v1/oil-prices": {
            "get": {
                "operationId": "v1.oil-prices.index",
                "description": "The weekly series, filtered by quality and date range.",
                "summary": "GET /api/v1/oil-prices",
                "tags": [
                    "OilPrice"
                ],
                "parameters": [
                    {
                        "name": "quality",
                        "in": "query",
                        "schema": {
                            "type": "string",
                            "enum": [
                                "extra",
                                "virgin",
                                "lampante"
                            ]
                        }
                    },
                    {
                        "name": "from",
                        "in": "query",
                        "schema": {
                            "type": "string",
                            "format": "date"
                        }
                    },
                    {
                        "name": "to",
                        "in": "query",
                        "schema": {
                            "type": "string",
                            "format": "date"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/OilPriceResource"
                                            }
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationException"
                    }
                }
            }
        },
        "/v1/oil-prices/latest": {
            "get": {
                "operationId": "v1.oil-prices.latest",
                "description": "Latest published week per quality, plus the week-over-week change.\nThe change is computed here, on the server, as a decimal: a client doing\nit in floating point would drift (spec §4.5).",
                "summary": "GET /api/v1/oil-prices/latest",
                "tags": [
                    "OilPrice"
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "string"
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    }
                }
            }
        },
        "/v1/oil-prices/campaigns/{campaign}/summary": {
            "get": {
                "operationId": "v1.oil-prices.campaign-summary",
                "description": "Mean, max and min per quality within a campaign. Spec §4.5.",
                "summary": "GET /api/v1/oil-prices/campaigns/{campaign}/summary",
                "tags": [
                    "OilPrice"
                ],
                "parameters": [
                    {
                        "name": "campaign",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "campaign": {
                                            "type": "string"
                                        },
                                        "data": {
                                            "type": "string"
                                        }
                                    },
                                    "required": [
                                        "campaign",
                                        "data"
                                    ]
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "message": {
                                            "type": "string"
                                        }
                                    },
                                    "required": [
                                        "message"
                                    ]
                                }
                            }
                        }
                    }
                }
            }
        },
        "/v1/parameters/current": {
            "get": {
                "operationId": "v1.parameters.current",
                "description": "The set that is live for a campaign. Optional `?campaign=` narrows it.",
                "summary": "GET /api/v1/parameters/current",
                "tags": [
                    "Parameter"
                ],
                "parameters": [
                    {
                        "name": "campaign",
                        "in": "query",
                        "schema": {
                            "type": "string",
                            "pattern": "^\\d{4}-\\d{2}$"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "message": {
                                            "anyOf": [
                                                {
                                                    "type": "string"
                                                },
                                                {
                                                    "type": "string",
                                                    "enum": [
                                                        "No hay un conjunto de parámetros publicado."
                                                    ]
                                                }
                                            ]
                                        }
                                    },
                                    "required": [
                                        "message"
                                    ]
                                }
                            }
                        }
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationException"
                    }
                }
            }
        },
        "/v1/parameters/{version}": {
            "get": {
                "operationId": "v1.parameters.show",
                "description": "A specific set, so an old saved calculation can be shown again with the\nfigures it was actually made with (spec §7.2).",
                "summary": "GET /api/v1/parameters/{version}",
                "tags": [
                    "Parameter"
                ],
                "parameters": [
                    {
                        "name": "version",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "message": {
                                            "type": "string"
                                        }
                                    },
                                    "required": [
                                        "message"
                                    ]
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "OilIndexQuoteResource": {
                "type": "object",
                "properties": {
                    "poolred_id": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "variation_pct": {
                        "type": "string",
                        "description": "Decimal string, never a JSON number: the frontend formats it and\nmust not see a float (spec §0.7)."
                    },
                    "quoted_on": {
                        "type": "string"
                    },
                    "period": {
                        "type": "string"
                    },
                    "source_stamp": {
                        "type": "string"
                    },
                    "is_finalized": {
                        "type": "boolean"
                    },
                    "source_url": {
                        "type": "string"
                    }
                },
                "required": [
                    "poolred_id",
                    "name",
                    "variation_pct",
                    "quoted_on",
                    "period",
                    "source_stamp",
                    "is_finalized",
                    "source_url"
                ],
                "title": "OilIndexQuoteResource"
            },
            "OilPriceResource": {
                "type": "object",
                "properties": {
                    "week_start": {
                        "type": "string"
                    },
                    "week_end": {
                        "type": "string"
                    },
                    "quality": {
                        "type": "string"
                    },
                    "avg_price_eur_t": {
                        "type": "string",
                        "description": "Decimal strings, per spec §7.1."
                    },
                    "avg_price_eur_kg": {
                        "type": "string"
                    },
                    "volume_t": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "provisional": {
                        "type": "boolean"
                    },
                    "source": {
                        "type": "string"
                    },
                    "source_url": {
                        "type": [
                            "string",
                            "null"
                        ]
                    }
                },
                "required": [
                    "week_start",
                    "week_end",
                    "quality",
                    "avg_price_eur_t",
                    "avg_price_eur_kg",
                    "volume_t",
                    "provisional",
                    "source",
                    "source_url"
                ],
                "title": "OilPriceResource"
            }
        },
        "responses": {
            "ValidationException": {
                "description": "Validation error",
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "message": {
                                    "type": "string",
                                    "description": "Errors overview."
                                },
                                "errors": {
                                    "type": "object",
                                    "description": "A detailed description of each field that failed validation.",
                                    "additionalProperties": {
                                        "type": "array",
                                        "items": {
                                            "type": "string"
                                        }
                                    }
                                }
                            },
                            "required": [
                                "message",
                                "errors"
                            ]
                        }
                    }
                }
            }
        }
    }
}
