---
/**
 * 404. Spec §10.2 lists it, and spec §12 keeps ads off it.
 */
import Base from '../layouts/Base.astro';

Astro.response.status = 404;
---

<Base
  title="Página no encontrada"
  description="La página que buscas no existe o ha cambiado de dirección."
  canonicalPath="/404"
  noindex
>
  <h1 class="text-3xl font-bold text-olive-800">No hemos encontrado esta página</h1>
  <p class="mt-2 text-lg text-earth-600">
    Puede que el enlace esté mal escrito o que la página haya cambiado.
  </p>

  <div class="mt-6 flex flex-wrap gap-2">
    <a class="btn btn-primary" href="/">Ir a la portada</a>
    <a class="btn btn-secondary" href="/guias">Ver las guías</a>
    <a class="btn btn-secondary" href="/herramientas/liquidacion-aceituna">
      Calcular una liquidación
    </a>
  </div>
</Base>
