---
/**
 * Índice iPOOL de POOLred (spec §10.2).
 *
 * This page used to be titled "Precio del aceite de oliva en origen" and show
 * three cards per quality. That was wrong twice over: the data behind it was
 * invented, and even real prices in origin would not be ours to publish.
 *
 * What it shows now is exactly what we are licensed and able to take:
 *
 *  - The weekly variation POOLred publishes for its four indices, from their
 *    public ticker endpoint, with their own names and their attribution.
 *  - A year of the Extra index, which their API serves without a token, averaged
 *    per calendar week.
 *
 * The title says "índice" rather than "precio" because that is what an index is:
 * a reference level, not a transaction price, and not an official quotation.
 */
import Base from '../layouts/Base.astro';
import AdSlot from '../components/AdSlot.astro';
import PriceChart from '../components/PriceChart';
import {
  getLatestIndexQuotes,
  getLatestPrices,
  getOilPrices,
} from '../lib/api';
import { formatDate, formatMoney, formatSignedPercent, qualityLabels } from '../lib/format';
import { PUBLIC_SITE_URL } from '../lib/seo';

const [quotes, latest, series] = await Promise.all([
  getLatestIndexQuotes(),
  getLatestPrices(),
  getOilPrices(),
]);

const latestWeek = latest[0]?.week_start ?? null;
const quotedOn = quotes[0]?.quoted_on ?? null;
const sourceUrl = quotes[0]?.source_url ?? 'https://poolred.com/';

// Only the index we can read anonymously, so the chart is unambiguous about what
// it is plotting.
const chartSeries = series.filter((row) => row.quality === 'extra');
const firstWeek = chartSeries[0];
const lastWeek = chartSeries[chartSeries.length - 1];

const dataset = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: 'Índice iPOOL de aceite de oliva (POOLred)',
  description:
    'Índice de referencia de precios en origen de la Fundación del Olivar, republished ' +
    'with attribution. Referencia de mercado, no precio oficial ni cotización.',
  url: new URL('/precio-aceite-oliva', PUBLIC_SITE_URL).toString(),
  creator: {
    '@type': 'Organization',
    name: 'Fundación del Olivar (POOLred)',
    url: sourceUrl,
  },
  isAccessibleForFree: true,
};
---

<Base
  title="Índice iPOOL del aceite de oliva (POOLred)"
  description="Índice de referencia de precios en origen de la Fundación del Olivar, con su variación semanal y un año de histórico del iPOOL Extra."
  canonicalPath="/precio-aceite-oliva"
  breadcrumbs={[{ name: 'Índice iPOOL' }, { name: 'POOLred' }]}
  schema={[dataset]}
>
  <h1 class="text-3xl font-bold text-olive-800">Índice iPOOL del aceite de oliva</h1>
  <p class="mt-2 max-w-2xl text-lg">
    Índice de referencia de precios en origen que publica la Fundación del Olivar a través de
    POOLred. Es un <strong>índice de mercado</strong>, no un precio oficial ni una cotización: sirve
    para saber cómo se mueve el mercado entre campañas.
  </p>

  {quotes.length === 0 ? (
    <p class="card mt-6 text-earth-600">
      Todavía no hay variaciones del índice publicadas. El importador corre dos veces al día.
    </p>
  ) : (
    <section class="mt-6">
      <h2 class="text-xl font-semibold text-olive-800">
        Variación semanal · {quotes[0].period}
      </h2>
      <ul class="mt-3 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {
          quotes.map((quote) => {
            const change = formatSignedPercent(quote.variation_pct);
            const tone =
              change.direction === 'up'
                ? 'text-green-800'
                : change.direction === 'down'
                  ? 'text-red-800'
                  : 'text-earth-600';
            return (
              <li class="card">
                <p class="text-sm text-earth-600">{quote.name}</p>
                <p class={`text-3xl font-bold tabular-nums ${tone}`}>{change.text}</p>
                <p class="text-sm text-earth-600">variación en el periodo</p>
                {!quote.is_finalized && (
                  <p class="mt-1 text-xs text-amber-800">Provisional, 95 % de confianza</p>
                )}
              </li>
            );
          })
        }
      </ul>
      <p class="mt-3 text-xs text-earth-600">
        Datos del {formatDate(quotedOn)}, actualizados por POOLred el {quotes[0].source_stamp}.
      </p>
    </section>
  )}

  {
    latest.length > 0 && (
      <section class="mt-6">
        <h2 class="text-xl font-semibold text-olive-800">
          iPOOL Extra · última semana · {formatDate(latestWeek)}
        </h2>
        <ul class="mt-3 grid gap-3 sm:grid-cols-2">
          <li class="card">
            <p class="text-sm text-earth-600">{qualityLabels.extra}</p>
            <p class="text-3xl font-bold tabular-nums text-olive-800">
              {formatMoney(latest[0].avg_price_eur_kg)}
            </p>
            <p class="text-sm text-earth-600">
              {formatMoney(latest[0].avg_price_eur_t)} por tonelada
            </p>
            {latest[0].provisional && (
              <p class="mt-1 text-xs text-amber-800">Provisional, pendiente de confirmar</p>
            )}
          </li>
        </ul>
      </section>
    )
  }

  <AdSlot slot="after-result" format="horizontal" />

  <div class="mt-6">
    <PriceChart series={chartSeries} client:visible />
  </div>

  {
    firstWeek !== undefined && lastWeek !== undefined && (
      <p class="mt-3 text-sm text-earth-600">
        Un año de histórico del índice Extra, de la semana del {formatDate(firstWeek.week_start)}{' '}
        a la del {formatDate(lastWeek.week_start)}.
      </p>
    )
  }

  <!--
    Attribution is not decoration here. The data is theirs, the page is ours, and a
    grower deciding whether to trust a number needs to know who published it and
    where to check it themselves.
  -->
  <aside class="card mt-8 border-l-4 border-l-olive-600">
    <h2 class="text-lg font-semibold text-olive-800">De dónde salen estos datos</h2>
    <p class="mt-2 text-sm">
      Todos los datos de esta página proceden del <strong>índice iPOOL</strong> de la
      <a class="underline" href={sourceUrl} rel="nofollow noopener" target="_blank">
        Fundación del Olivar (POOLred)</a>, obtenidos con su autorización. El histórico se
      agrega por semana a partir de la serie diaria que publica su API, y la variación
      semanal de los cuatro índices procede de su ticker público.
    </p>
    <p class="mt-2 text-sm text-earth-600">
      Los importes provisionales son los que POOLred etiqueta con un 95 % de confianza y pueden
      variar. Ninguna cifra de esta página es una cotización oficial ni un precio de las Lonjas.
    </p>
  </aside>

  <p class="mt-8 max-w-2xl text-sm text-earth-600">
    Consulta <a class="underline" href="/guias/precios-aceite-origen">la guía de precios en
    origen</a> para entender cómo se forma un precio y qué diferencia hay entre un índice y una
    cotización.
  </p>
</Base>